<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Selamat Bertambah Umur</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    overflow: hidden;
    font-family: Arial, sans-serif;
    color: white;
    background:
        radial-gradient(circle at 50% 20%, #54206d, #190025 55%, #050008);
}

/* ================= HALAMAN ================= */

.page {
    position: absolute;
    width: 100%;
    height: 100vh;

    display: flex;
    justify-content: center;
    align-items: center;

    text-align: center;
    padding: 25px;

    opacity: 0;
    pointer-events: none;
    transform: scale(0.94);

    transition:
        opacity 0.8s ease,
        transform 0.8s ease;
}

.page.active {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
}

.content {
    width: 100%;
    max-width: 700px;
}

/* ================= TEXT ================= */

h1 {
    margin: 0;
    font-size: clamp(42px, 10vw, 90px);
    font-weight: 900;
    letter-spacing: 2px;

    text-shadow:
        0 0 10px white,
        0 0 25px #ff69b4,
        0 0 50px #ff1493;
}

h2 {
    font-size: clamp(32px, 7vw, 55px);
    margin-bottom: 25px;

    text-shadow:
        0 0 10px white,
        0 0 25px #ff69b4;
}

p {
    font-size: 19px;
    line-height: 1.8;
    opacity: 0.9;
}

/* ================= BUTTON ================= */

button {
    margin-top: 25px;

    padding: 15px 30px;

    border: none;
    border-radius: 50px;

    background: linear-gradient(
        45deg,
        #ff1493,
        #ff69b4
    );

    color: white;

    font-size: 17px;
    font-weight: bold;

    cursor: pointer;

    box-shadow:
        0 0 15px #ff1493,
        0 0 35px rgba(255,20,147,0.5);

    transition: 0.2s;
}

button:hover {
    transform: scale(1.05);
}

button:active {
    transform: scale(0.92);
}

/* ================= HUJAN KUE ================= */

.cake {
    position: fixed;

    top: -80px;

    pointer-events: none;

    z-index: 50;

    animation-name: fall;
    animation-timing-function: linear;
    animation-fill-mode: forwards;
}

@keyframes fall {

    0% {
        transform:
            translateY(-100px)
            rotate(0deg);

        opacity: 1;
    }

    100% {
        transform:
            translateY(115vh)
            rotate(720deg);

        opacity: 0.9;
    }
}

/* ================= CONFETTI ================= */

.confetti {
    position: fixed;

    top: -20px;

    width: 8px;
    height: 15px;

    pointer-events: none;

    z-index: 40;

    animation:
        confettiFall linear forwards;
}

@keyframes confettiFall {

    0% {
        transform:
            translateY(-30px)
            rotate(0deg);
    }

    100% {
        transform:
            translateY(110vh)
            rotate(720deg);
    }
}

/* ================= BINTANG ================= */

.star {
    position: fixed;

    color: white;

    opacity: 0.5;

    animation: blink 2s infinite alternate;
}

@keyframes blink {

    from {
        opacity: 0.2;
    }

    to {
        opacity: 0.9;
    }
}

/* ================= TOMBOL MUSIK ================= */

.musicButton {
    position: fixed;

    right: 18px;
    top: 18px;

    width: 45px;
    height: 45px;

    padding: 0;
    margin: 0;

    border-radius: 50%;

    font-size: 20px;

    z-index: 100;
}

/* ================= MOBILE ================= */

@media(max-width:600px) {

    p {
        font-size: 17px;
    }

    button {
        font-size: 15px;
        padding: 13px 25px;
    }
}
</style>
</head>

<body>


<!-- ================= MUSIK ================= -->

<audio id="musik" loop>
    <source src="tiptoe.mp3" type="audio/mpeg">
</audio>

<button
    class="musicButton"
    onclick="toggleMusic()"
    id="musicBtn">
    🔊
</button>


<!-- ================= BINTANG ================= -->

<div class="star" style="top:10%;left:10%;">✦</div>
<div class="star" style="top:20%;left:80%;">✦</div>
<div class="star" style="top:70%;left:15%;">✦</div>
<div class="star" style="top:80%;left:90%;">✦</div>
<div class="star" style="top:15%;left:50%;">✦</div>
<div class="star" style="top:60%;left:70%;">✦</div>


<!-- ================================================= -->
<!-- HALAMAN 1 -->
<!-- ================================================= -->

<section
    class="page active"
    id="page1">

    <div class="content">

        <h1>
            SELAMAT<br>
            BERTAMBAH UMUR
        </h1>

        <p>
            Hari ini adalah hari yang spesial.
        </p>

        <button onclick="mulaiKejutan()">
            🎂 BUKA KEJUTANNYA
        </button>

    </div>

</section>


<!-- ================================================= -->
<!-- HALAMAN 2 -->
<!-- ================================================= -->

<section
    class="page"
    id="page2">

    <div class="content">

        <h2>
            ✨ Ada Sedikit Kejutan
        </h2>

        <p>
            Sebelum lanjut ke halaman berikutnya,
            nikmati dulu kejutan kecil ini.
            <br><br>

            Semoga bisa membuat hari ulang tahunmu
            menjadi sedikit lebih seru.
        </p>

        <button onclick="nextPage(3)">
            LANJUT →
        </button>

    </div>

</section>


<!-- ================================================= -->
<!-- HALAMAN 3 -->
<!-- ================================================= -->

<section
    class="page"
    id="page3">

    <div class="content">

        <h2>
            🎉 Selamat Bertambah Umur
        </h2>

        <p>
            Semoga di usia yang baru,
            kesehatan, kebahagiaan,
            dan hal-hal baik selalu menyertai.
            <br><br>

            Semoga semakin banyak pengalaman
            menyenangkan yang bisa didapatkan
            di tahun ini.
        </p>

        <button onclick="nextPage(4)">
            MASIH ADA SATU LAGI →
        </button>

    </div>

</section>


<!-- ================================================= -->
<!-- HALAMAN 4 -->
<!-- ================================================= -->

<section
    class="page"
    id="page4">

    <div class="content">

        <h2>
            🌟 Untuk Tahun Yang Baru
        </h2>

        <p>
            Semoga apa yang sedang diperjuangkan
            perlahan bisa tercapai.
            <br><br>

            Tetap semangat,
            jangan takut mencoba hal baru,
            dan jangan lupa menikmati
            setiap prosesnya.
        </p>

        <button onclick="nextPage(5)">
            LANJUT KE PESAN TERAKHIR →
        </button>

    </div>

</section>


<!-- ================================================= -->
<!-- HALAMAN 5 -->
<!-- ================================================= -->

<section
    class="page"
    id="page5">

    <div class="content">

        <h1>
            🎂
        </h1>

        <h2>
            SELAMAT ULANG TAHUN
        </h2>

        <p>
            Semoga tahun ini menjadi tahun
            yang penuh cerita baik,
            pengalaman baru,
            dan banyak hal yang bisa dibanggakan.
            <br><br>

            Nikmati setiap momennya
            dan tetap jadi versi terbaik dari dirimu.
            <br><br>

            <strong>
                Semoga semua yang diharapkan
                bisa tercapai.
            </strong>
        </p>

    </div>

</section>


<script>

/* ================================================= */
/* MUSIK */
/* ================================================= */

const musik = document.getElementById("musik");

const musicBtn =
    document.getElementById("musicBtn");


function toggleMusic() {

    if (musik.paused) {

        musik.play();

        musicBtn.innerHTML = "🔊";

    } else {

        musik.pause();

        musicBtn.innerHTML = "🔇";

    }

}


/* ================================================= */
/* MULAI KEJUTAN */
/* ================================================= */

function mulaiKejutan() {

    musik.play();

    hujanKue();

    confetti();

    /*
       Hujan berlangsung beberapa detik
       sebelum pindah halaman
    */

    setTimeout(() => {

        nextPage(2);

    }, 5500);

}


/* ================================================= */
/* PINDAH HALAMAN */
/* ================================================= */

function nextPage(number) {

    document
        .querySelectorAll(".page")
        .forEach(page => {

            page.classList.remove("active");

        });


    document
        .getElementById("page" + number)
        .classList.add("active");

}


/* ================================================= */
/* HUJAN KUE */
/* ================================================= */

function hujanKue() {

    const jenisKue = [
        "🎂",
        "🍰",
        "🧁",
        "🍩",
        "🎁"
    ];


    for (let i = 0; i < 100; i++) {

        const cake =
            document.createElement("div");


        cake.className = "cake";


        cake.innerHTML =
            jenisKue[
                Math.floor(
                    Math.random() *
                    jenisKue.length
                )
            ];


        cake.style.left =
            Math.random() * 100 + "vw";


        cake.style.fontSize =
            (20 + Math.random() * 35) +
            "px";


        cake.style.animationDuration =
            (2 + Math.random() * 4) +
            "s";


        cake.style.animationDelay =
            Math.random() * 2 +
            "s";


        document.body.appendChild(cake);


        setTimeout(() => {

            cake.remove();

        }, 8000);

    }

}


/* ================================================= */
/* CONFETTI */
/* ================================================= */

function confetti() {

    for (let i = 0; i < 100; i++) {

        const piece =
            document.createElement("div");


        piece.className =
            "confetti";


        piece.style.left =
            Math.random() * 100 +
            "vw";


        piece.style.width =
            (5 + Math.random() * 7) +
            "px";


        piece.style.height =
            (8 + Math.random() * 12) +
            "px";


        piece.style.background =
            [
                "#ff1493",
                "#ffd700",
                "#00ffff",
                "#7fff00",
                "#ff6347",
                "#ffffff"
            ][
                Math.floor(
                    Math.random() * 6
                )
            ];


        piece.style.animationDuration =
            (2 + Math.random() * 4) +
            "s";


        piece.style.animationDelay =
            Math.random() * 2 +
            "s";


        document.body.appendChild(piece);


        setTimeout(() => {

            piece.remove();

        }, 7000);

    }

}

</script>

</body>
</html>
